{
  "port": 8080,
  "host": "0.0.0.0",
  "requestTimeoutMs": 15000,
  "breaker": { "failureThreshold": 5, "resetTimeoutMs": 30000 },
  "healthCheck": {
    "path": "/health",
    "intervalMs": 10000,
    "unhealthyThreshold": 3,
    "healthyThreshold": 2
  },
  "routes": [
    {
      "pathPrefix": "/api/v1/inference",
      "strategy": "weighted-round-robin",
      "targets": [
        { "url": "http://gpu-cluster-a:8080", "weight": 3 },
        { "url": "http://gpu-cluster-b:8080", "weight": 1 }
      ],
      "rateLimit": { "capacity": 100, "refillRatePerSec": 20 }
    },
    {
      "pathPrefix": "/api",
      "strategy": "least-connections",
      "stripPrefix": true,
      "targets": ["http://app-1:3000", "http://app-2:3000"]
    }
  ]
}
